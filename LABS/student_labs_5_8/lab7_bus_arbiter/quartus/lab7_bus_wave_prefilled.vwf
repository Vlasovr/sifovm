/* Prefilled waveform for lab7 bus arbiter: reset, request accumulation, quantum arbitration and bus transfer. */

HEADER
{
	VERSION = 1;
	TIME_UNIT = ns;
	DATA_OFFSET = 0.0;
	DATA_DURATION = 220.0;
	SIMULATION_TIME = 220.0;
	GRID_PHASE = 0.0;
	GRID_PERIOD = 10.0;
	GRID_DUTY_CYCLE = 50;
}

