INCLUDE "lpm_clshift.inc";



SUBDESIGN alu_shifter_srl
(
	data[7..0]	 : INPUT;
	distance	 : INPUT;
	result[7..0]	 : OUTPUT;
)

VARIABLE

	lpm_clshift_component : lpm_clshift WITH (
			LPM_SHIFTTYPE = "LOGICAL",
			LPM_TYPE = "LPM_CLSHIFT",
			LPM_WIDTH = 8,
			LPM_WIDTHDIST = 1
			);

BEGIN

	result[7..0] = lpm_clshift_component.result[7..0];
	lpm_clshift_component.distance[0..0] = distance;
	lpm_clshift_component.direction = VCC;
	lpm_clshift_component.data[7..0] = data[7..0];
END;



