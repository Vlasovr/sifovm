-- Quartus II generated Memory Initialization File (.mif)

WIDTH = 5;
DEPTH = 16;
ADDRESS_RADIX = DEC;
DATA_RADIX = HEX;

CONTENT BEGIN
    -- УНИКАЛЬНЫЕ значения для проверки!
    0 : 00;  -- IDLE, start=0, zero=0
    1 : 11;  -- IDLE, start=0, zero=1
    2 : 22;  -- IDLE, start=1, zero=0 ← СЮДА ПОПАДАЕТ ПРИ СТАРТЕ!
    3 : 33;  -- IDLE, start=1, zero=1
    4 : 44;  -- REQUEST
    5 : 55;
    6 : 66;
    7 : 77;
    8 : 88;  -- TRANSFER
    9 : 99;
    10: AA;
    11: BB;
    12: CC;  -- COMPLETE
    13: DD;
    14: EE;
    15: FF;
END;