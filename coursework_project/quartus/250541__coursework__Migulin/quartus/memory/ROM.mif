DEPTH = 65536;              -- Количество адресов (64К)
WIDTH = 8;                  -- Ширина слова (8 бит)
ADDRESS_RADIX = HEX;        -- Адреса в HEX
DATA_RADIX = HEX;           -- Данные в HEX

CONTENT BEGIN
  -- ==========================================
  -- ПРОГРАММА (Начинается с адреса 0000)
  -- ==========================================

  -- 0. Инициализация
  0000 : 00;                -- NOP (задержка для стабильности)

  -- 1. Загрузка данных из памяти (M->R)
  -- Команда: M->R R0, Addr=0030h
  0001 : 30;                
  0002 : 00;                -- Адрес старший байт (00)
  0003 : 30;                -- Адрес младший байт (30) -> Целевой адрес 0030h
  
  -- Команда: M->R R1, Addr=0031h
  0004 : 31;                
  0005 : 00;                
  0006 : 31;                ---> Целевой адрес 0031h

  -- 2. Арифметика и логика
  0007 : 10;                -- SUB R0 (R0 <- R0 - R1) 
                            -- Ожидаем: 0A - 05 = 05. Флаги: Z=0, S=0, CF=0
                            
  0008 : 60;                -- AND R0 (R0 <- R0 AND R1)
                            -- Ожидаем: 05 AND 05 = 05.
                            
  0009 : 70;                -- NOTZ R0 (Инверсия, если Z=0)
                            -- Так как результат 05 (не ноль), Z=0. Инверсия выполнится? 
                            -- Проверь логику NOTZ в своем АЛУ. Обычно это "Инвертировать, если Z=1" или "Инвертировать всегда".
                            -- В варианте 8 обычно NOTZ = инверсия результата, если флаг Z=0 (результат не ноль)? 
                            -- Уточни в методичке: чаще всего NOTZ означает "Инвертировать аккумулятор".
                            -- Пусть будет просто операция инверсии для теста.
                            
  000A : 50;                -- SRL R0 (Сдвиг вправо логический)
                            -- Ожидаем: FA >> 1 = 7D (если было FA) или 05 >> 1 = 02.

  -- 3. Стек
  000B : 80;                -- PUSH R0 (Записать R0 в стек)
  000C : 92;                -- POP R2  (Извлечь из стека в R2)

  -- 4. Запись в память (R->M)
  -- Команда: R->M R2, Addr=0032h
  000D : 42;                
  000E : 00;                
  000F : 32;                ---> Целевой адрес 0032h

  -- 5. Переход и останов
  0010 : 20;                -- JMP 0007h (Цикл: вернуться к SUB)
  0011 : 00;                
  0012 : 07;                
  
  0013 : FF;                -- HLT (Останов)

  -- Заполнение пустот программы нулями
  [0014..002F] : 00;

  -- ==========================================
  -- ДАННЫЕ (Для работы программы)
  -- ==========================================
  
  -- Адреса, куда обращается программа M->R и R->M
  0030 : 0A;                -- Данные для R0 (Число 10)
  0031 : 05;                -- Данные для R1 (Число 5)
  0032 : 00;                -- Ячейка для результата записи R->M (изначально 0)
  
  -- Заполним соседние ячейки для наглядности в симуляции
  [0033..003F] : 00;

  -- Остальная память до конца
  [0040..FFFF] : 00;

END;